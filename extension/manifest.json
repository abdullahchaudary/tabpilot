{
  "manifest_version": 3,
  "name": "tabpilot",
  "version": "0.2.0",
  "description": "Hand your AI the controls. Pairs with the tabpilot daemon so Claude Code (or any MCP client) can drive and debug this browser.",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "tabpilot",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "commands": {
    "toggle-pause": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Pause / resume the AI"
    },
    "mayday": {
      "suggested_key": {
        "default": "Alt+Shift+X"
      },
      "description": "MAYDAY: release every tab and disconnect"
    }
  }
}
